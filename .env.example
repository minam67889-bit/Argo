# Argo environment variables
# Copy to .env and fill in

# Required: LLM endpoint
LLM_API_KEY=sk-or-v1-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-coder:free

# Optional: agent behavior
AGENT_MAX_STEPS=40
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=8192
AGENT_CONTEXT_WINDOW=20000
AGENT_AUTO_APPROVE=false
AGENT_BASH_TIMEOUT=120

# Optional: server
ARGO_HOST=0.0.0.0
ARGO_PORT=8000
ARGO_WORKSPACE=./workspaces/default

# Optional: storage
ARGO_DB=./data/argo.db
